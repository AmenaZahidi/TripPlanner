@using TripPlanner.Models
@using TripPlanner.Services
@inject IWikipediaService WikipediaService

@* Shows a photo and a short description of the place, from Wikipedia *@
@if (isLoading)
{
    <div class="card shadow-sm">
        <div class="card-body d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span>Loading place information...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="text-muted small">@errorMessage</div>
}
else if (info is not null)
{
    <div class="card shadow-sm tp-about overflow-hidden">
        <div class="row g-0">
            @if (!string.IsNullOrEmpty(info.ImageUrl))
            {
                <div class="col-md-4">
                    <img src="@info.ImageUrl" alt="@info.Title" class="tp-about-img" />
                </div>
            }

            <div class="@(string.IsNullOrEmpty(info.ImageUrl) ? "col-12" : "col-md-8")">
                <div class="card-body">
                    <h5 class="card-title mb-0">About @info.Title</h5>

                    @if (!string.IsNullOrEmpty(info.Description))
                    {
                        <div class="text-muted small mb-2">@info.Description</div>
                    }

                    <p class="card-text">@info.Summary</p>

                    @if (!string.IsNullOrEmpty(info.PageUrl))
                    {
                        <a href="@info.PageUrl" target="_blank" rel="noopener">Read more on Wikipedia</a>
                    }
                </div>
            </div>
        </div>
    </div>
}
@* If Wikipedia has no page for this place, nothing is shown and the rest of the page still works *@

@code {
    [Parameter]
    public Destination? Place { get; set; }

    private bool isLoading;
    private string? errorMessage;
    private PlaceInfo? info;
    private int? loadedPlaceId;

    // Blazor runs this every time the Place changes
    protected override async Task OnParametersSetAsync()
    {
        // Same place as last time, so don't ask again
        if (Place is null || Place.Id == loadedPlaceId)
        {
            return;
        }

        loadedPlaceId = Place.Id;
        isLoading = true;
        errorMessage = null;
        info = null;

        try
        {
            info = await WikipediaService.GetInfoAsync(Place);
        }
        catch (WikipediaServiceException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}