@inherits LayoutComponentBase

<header class="tp-header">
    <div class="tp-container tp-header-inner">
        <a class="tp-logo" href="">✈️ TripPlanner</a>
        <nav class="tp-nav">
            <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="destinations">Destinations</NavLink>
            <NavLink href="shortlist">⭐ Shortlist</NavLink>
        </nav>
    </div>
</header>

<main class="tp-main">
    <div class="tp-container">
        @Body
    </div>
</main>

<footer class="tp-footer">
    <div class="tp-container">
        Weather and places by Open-Meteo · Exchange rates by Frankfurter ·
        Place photos and info from Wikipedia · Student project
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>