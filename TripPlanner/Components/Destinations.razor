@page "/destinations"
@using TripPlanner.Models
@using TripPlanner.Services
@inject IDestinationService DestinationService
@inject IWeatherService WeatherService

<PageTitle>Find a destination</PageTitle>

<h1 class="mb-3">Find a destination</h1>

@* Search box. oninput means the text updates as I type, so Enter works properly *@
<div class="input-group mb-4">
    <input class="form-control"
           placeholder="Search for a city, e.g. Lisbon"
           @bind="searchText"
           @bind:event="oninput"
           @onkeydown="HandleKeyDown" />
    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@isLoading">Search</button>
</div>

@* Only one of these shows at a time: loading, error, no results, or results *@
@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Searching...</span>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (results is not null && results.Count == 0)
{
    <div class="alert alert-info">No places found for "@lastSearch". Try a different spelling.</div>
}
else if (results is not null)
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var place in results)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@place.Name</h5>
                        <p class="card-text text-muted mb-1">@FormatLocation(place)</p>
                        @if (place.Population is not null)
                        {
                            <small class="text-muted d-block">Population: @place.Population.Value.ToString("N0")</small>
                        }
                        <button class="btn btn-outline-primary btn-sm mt-2"
                                @onclick="() => SelectDestinationAsync(place)">
                            View forecast
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Forecast section. Only shows after I click "View forecast" on a place *@
@if (selectedPlace is not null)
{
    <hr class="my-4" />
    <h3 class="mb-3">7 day forecast for @selectedPlace.Name</h3>

    @if (isLoadingForecast)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Getting the forecast...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(forecastError))
    {
        <div class="alert alert-danger">@forecastError</div>
    }
    else if (forecast is not null && forecast.Count == 0)
    {
        <div class="alert alert-info">No forecast available for this place.</div>
    }
    else if (forecast is not null)
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var day in forecast)
            {
                <div class="card text-center shadow-sm" style="width: 8.5rem;">
                    <div class="card-body p-2">
                        <div class="fw-bold">@day.Date.ToString("ddd d MMM")</div>
                        <div style="font-size: 2rem;">@WeatherCodeHelper.GetIcon(day.WeatherCode)</div>
                        <div class="small">@WeatherCodeHelper.GetDescription(day.WeatherCode)</div>
                        <div>@day.MaxTemperature.ToString("0")° / @day.MinTemperature.ToString("0")°</div>
                        <div class="small text-muted">💧 @day.PrecipitationMm.ToString("0.#") mm</div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private string searchText = string.Empty;
    private string lastSearch = string.Empty;
    private List<Destination>? results;
    private bool isLoading;
    private string? errorMessage;

    // Forecast for the place I clicked on
    private Destination? selectedPlace;
    private List<DayForecast>? forecast;
    private bool isLoadingForecast;
    private string? forecastError;

    // Lets the user press Enter instead of clicking the button
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            errorMessage = "Please type a place to search for.";
            results = null;
            return;
        }

        isLoading = true;
        errorMessage = null;
        results = null;
        lastSearch = searchText.Trim();

        // New search, so clear the old forecast
        selectedPlace = null;
        forecast = null;
        forecastError = null;

        try
        {
            results = await DestinationService.SearchAsync(lastSearch);
        }
        catch (DestinationServiceException ex)
        {
            // The message from the service is already user friendly
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Runs when I click "View forecast" on a card
    private async Task SelectDestinationAsync(Destination place)
    {
        selectedPlace = place;
        forecast = null;
        forecastError = null;
        isLoadingForecast = true;

        try
        {
            forecast = await WeatherService.GetForecastAsync(place.Latitude, place.Longitude);
        }
        catch (WeatherServiceException ex)
        {
            forecastError = ex.Message;
        }
        finally
        {
            isLoadingForecast = false;
        }
    }

    // Joins region and country, skipping any that are missing (they can be null)
    private static string FormatLocation(Destination place) =>
        string.Join(", ", new[] { place.Region, place.Country }
            .Where(s => !string.IsNullOrWhiteSpace(s)));
}