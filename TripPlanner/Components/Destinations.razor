@page "/destinations"
@using TripPlanner.Models
@using TripPlanner.Services
@inject IDestinationService DestinationService
@inject IWeatherService WeatherService
@inject ITripShortlistService Shortlist

<PageTitle>Find a destination</PageTitle>

<h1 class="mb-3">Find a destination</h1>

@* Search box. Pressing Enter also searches *@
<div class="input-group mb-4" style="max-width: 36rem;">
    <input type="text"
           class="form-control"
           placeholder="Type a city, e.g. Tokyo"
           @bind="searchText"
           @bind:event="oninput"
           @onkeydown="HandleKeyDown" />
    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@isLoading">Search</button>
</div>

@* Search results. Only one of these shows at a time *@
@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Searching...</span>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (results is not null && results.Count == 0)
{
    <div class="alert alert-warning">No places found for "@lastSearch". Try another spelling.</div>
}
else if (results is not null)
{
    <p class="text-muted">Found @results.Count places for "@lastSearch". Pick the right one:</p>

    <div class="row g-3">
        @foreach (var place in results)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@place.Name</h5>
                        <p class="card-text text-muted">@FormatLocation(place)</p>
                        <button class="btn @(selectedPlace?.Id == place.Id ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => SelectDestinationAsync(place)">
                            View forecast
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Forecast section. Only shows after I click "View forecast" on a place *@
@if (selectedPlace is not null)
{
    <hr class="my-4" />

    <h3 class="mb-3">@selectedPlace.Name (@FormatLocation(selectedPlace))</h3>

    @* The currency card gets its own data from the Frankfurter API *@
    <CurrencyCard Place="selectedPlace" />

    @* The shortlist button only shows once the forecast has loaded *@
    @if (forecast is { Count: > 0 })
    {
        <button class="btn btn-success mt-3" @onclick="AddToShortlist">⭐ Add to shortlist</button>
        @if (!string.IsNullOrEmpty(shortlistMessage))
        {
            <span class="ms-2">@shortlistMessage</span>
        }
    }

    <h4 class="mt-4 mb-3">7 day forecast</h4>

    @if (isLoadingForecast)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Getting the forecast...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(forecastError))
    {
        <div class="alert alert-danger">@forecastError</div>
    }
    else if (forecast.Count == 0)
    {
        <div class="alert alert-warning">No forecast available for this place.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var day in forecast)
            {
                <div class="col-6 col-md-4 col-lg">
                    <div class="card shadow-sm h-100 text-center">
                        <div class="card-body">
                            <h6 class="card-title">@day.Date.ToString("ddd d MMM")</h6>
                            <div style="font-size: 2.5rem;">@WeatherCodeHelper.GetIcon(day.WeatherCode)</div>
                            <div>@WeatherCodeHelper.GetDescription(day.WeatherCode)</div>
                            <div class="fw-bold mt-2">@($"{day.MaxTemperature:0}° / {day.MinTemperature:0}°")</div>
                            <small class="text-muted">💧 @day.PrecipitationMm.ToString("0.#") mm</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    // What the user typed and what they last searched for
    private string searchText = string.Empty;
    private string lastSearch = string.Empty;

    // Search state. results is null until the first search is done
    private List<Destination>? results;
    private bool isLoading;
    private string? errorMessage;

    // Forecast state
    private Destination? selectedPlace;
    private List<DayForecast> forecast = new();
    private bool isLoadingForecast;
    private string? forecastError;

    // Message shown after pressing "Add to shortlist"
    private string? shortlistMessage;

    // Search when the user presses Enter
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        // Clear everything from the last search first
        errorMessage = null;
        results = null;
        selectedPlace = null;
        forecast = new();
        forecastError = null;
        shortlistMessage = null;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            errorMessage = "Please type a place name first.";
            return;
        }

        isLoading = true;
        lastSearch = searchText.Trim();

        try
        {
            results = await DestinationService.SearchAsync(lastSearch);
        }
        catch (DestinationServiceException ex)
        {
            // The service gives a friendly message, so I can show it straight away
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectDestinationAsync(Destination place)
    {
        shortlistMessage = null;
        selectedPlace = place;
        forecast = new();
        forecastError = null;
        isLoadingForecast = true;

        try
        {
            forecast = await WeatherService.GetForecastAsync(place.Latitude, place.Longitude);
        }
        catch (WeatherServiceException ex)
        {
            forecastError = ex.Message;
        }
        finally
        {
            isLoadingForecast = false;
        }
    }

    // Saves the selected place and a summary of its forecast to the shortlist
    private void AddToShortlist()
    {
        if (selectedPlace is null || forecast is null || forecast.Count == 0)
        {
            return;
        }

        var item = new ShortlistItem
        {
            Place = selectedPlace,
            AverageMaxTemperature = forecast.Average(d => d.MaxTemperature),
            TotalRainMm = forecast.Sum(d => d.PrecipitationMm)
        };

        shortlistMessage = Shortlist.Add(item) ? "Added to your shortlist!" : "Already on your shortlist.";
    }

    // Joins the region and country, and skips any that are empty
    private static string FormatLocation(Destination place)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(place.Region))
        {
            parts.Add(place.Region);
        }

        if (!string.IsNullOrWhiteSpace(place.Country))
        {
            parts.Add(place.Country);
        }

        return string.Join(", ", parts);
    }
}